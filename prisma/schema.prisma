// Gym Management System — Day 1 Schema
// Multi-tenant-ready: every organization-owned model carries an organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  STAFF
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

// ---------------------------------------------------------------------------
// Organization — the tenant boundary. Every other business entity below
// (except AuditLog/User, which reference it directly) is scoped to one.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  members       Member[]
  plans         MembershipPlan[]
  subscriptions Subscription[]
  payments      Payment[]
  attendance    Attendance[]
  expenses      Expense[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// User — staff/owner accounts. Auth (login, password hashing/verification,
// sessions) is intentionally NOT implemented on Day 1, but the shape below
// (passwordHash, role, isActive) is designed so it can be added without a
// schema rewrite.
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]    @relation("PaymentCreatedBy")
  expenses     Expense[]    @relation("ExpenseCreatedBy")
  auditLogs    AuditLog[]

  // Same email may exist across different gyms, but must be unique per gym.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Member — a gym member belonging to one organization.
// ---------------------------------------------------------------------------

model Member {
  id               String       @id @default(cuid())
  organizationId   String
  memberCode       String
  name             String
  phone            String
  email            String?
  gender           String?
  dateOfBirth      DateTime?
  joiningDate      DateTime     @default(now())
  address          String?
  emergencyContact String?
  status           MemberStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments      Payment[]
  attendance    Attendance[]

  // memberCode is human-assigned (e.g. "GYM-0001") and must be unique per gym,
  // not globally, so multiple gyms can each start their own numbering.
  @@unique([organizationId, memberCode])
  @@index([organizationId])
  @@index([phone])
  @@index([status])
  @@map("members")
}

// ---------------------------------------------------------------------------
// MembershipPlan — created dynamically by the gym owner (not seeded).
// ---------------------------------------------------------------------------

model MembershipPlan {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  durationInDays Int
  price          Decimal  @db.Decimal(10, 2)
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([organizationId])
  @@map("membership_plans")
}

// ---------------------------------------------------------------------------
// Subscription — links a Member to a MembershipPlan for a period.
// ---------------------------------------------------------------------------

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  memberId       String
  planId         String
  startDate      DateTime
  endDate        DateTime
  amount         Decimal            @db.Decimal(10, 2)
  status         SubscriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Payment — an individual financial transaction. Never aggregate-only.
// ---------------------------------------------------------------------------

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  memberId       String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  paymentDate    DateTime      @default(now())
  receiptNumber  String
  status         PaymentStatus @default(COMPLETED)
  notes          String?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creator      User?         @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  // Receipt numbers are sequential per gym, not globally.
  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([memberId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Attendance — one check-in record per member per day.
// ---------------------------------------------------------------------------

model Attendance {
  id             String    @id @default(cuid())
  organizationId String
  memberId       String
  date           DateTime  @db.Date
  checkInTime    DateTime?
  checkOutTime   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Prevents duplicate attendance rows for the same member on the same day.
  @@unique([memberId, date])
  @@index([organizationId])
  @@index([date])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Expense — for future financial reporting. No UI yet.
// ---------------------------------------------------------------------------

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  amount         Decimal  @db.Decimal(10, 2)
  category       String
  expenseDate    DateTime @default(now())
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([expenseDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// AuditLog — append-only trail for financially/administratively sensitive
// actions. oldData/newData are JSON snapshots.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String
  oldData        Json?
  newData        Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
